{
  "name": "securscan",
  "version": "1.0.0",
  "description": "Plateforme d'audit de sécurité web, détection de régressions et guide de remédiation",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server/index.js",
    "worker": "node src/server/worker.js",
    "start": "node src/server/index.js",
    "scan": "node src/scanner/index.js",
    "test": "mocha --exit"
  },
  "keywords": [
    "security",
    "audit",
    "dast",
    "vulnerabilities",
    "cwe",
    "ssl",
    "headers"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "supertest": "^6.3.3"
  },
  "bin": {
    "securscan-worker": "src/server/worker.js"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
